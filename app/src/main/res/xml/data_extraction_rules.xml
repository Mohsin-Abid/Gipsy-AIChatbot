<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup rules. Chat history stays on the device it was created on, so the conversation
  database is excluded from cloud backup *and* from direct device-to-device transfer — a transfer
  still takes the messages off this device. The user's settings restore either way: they are in
  DataStore (files/). Shared preferences and databases are all SDK state tied to one device (Firebase
  sign-in tokens, analytics queues, the offline speech model flag) and are excluded wholesale, so a
  restored phone starts its own sessions instead of inheriting another's.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="database" path="aitutor.db" />
        <exclude domain="database" path="aitutor.db-journal" />
        <exclude domain="database" path="aitutor.db-shm" />
        <exclude domain="database" path="aitutor.db-wal" />
        <exclude domain="file" path="attachments/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="database" path="aitutor.db" />
        <exclude domain="database" path="aitutor.db-journal" />
        <exclude domain="database" path="aitutor.db-shm" />
        <exclude domain="database" path="aitutor.db-wal" />
        <exclude domain="file" path="attachments/" />
    </device-transfer>
</data-extraction-rules>
