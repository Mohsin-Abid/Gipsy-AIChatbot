<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Dictation. Asked for at the moment the mic is tapped, not at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Needed on API 30+ for ACTION_IMAGE_CAPTURE to resolve: without it the camera app is invisible
      to this process and the Camera tile would quietly do nothing.

      Note what is NOT declared here: android.permission.CAMERA. The system camera app takes the
      photo, so this app never touches the camera itself — and declaring the permission would make
      ACTION_IMAGE_CAPTURE demand a runtime grant it otherwise does not need.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!--
          Speech recognition is not part of Android: it is a service some installed app provides.
          Without this entry, package visibility on API 30+ hides every such service from this
          process and SpeechRecognizer.isRecognitionAvailable() answers false even on a device that
          has one.
        -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AITutorApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AITutor">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AITutor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a writable URI for one capture, without exporting app storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
