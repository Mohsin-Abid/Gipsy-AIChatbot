<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A normal permission, granted at install with no prompt: it only lets the app ask whether there is a connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Firebase Analytics adds three advertising permissions by default: the Play services advertising
      ID, and the two Android 13+ Privacy Sandbox ones for the ad ID and ad attribution. This app shows
      no ads and has no use for any of them, and keeping the first would oblige an "Advertising ID"
      declaration in Play Console. Removing them costs a few attribution features, none of which are used.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <!-- Dictation. Asked for at the moment the mic is tapped, not at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Dictation is an optional extra — typing works without it — so a device with no microphone must
      still be able to install the app. Declaring RECORD_AUDIO on its own implies
      android.hardware.microphone as *required*, which makes Play hide the app from any device that
      lacks one.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Needed on API 30+ for ACTION_IMAGE_CAPTURE to resolve: without it the camera app is invisible
      to this process and the Camera tile would quietly do nothing.

      Note what is NOT declared here: android.permission.CAMERA. The system camera app takes the
      photo, so this app never touches the camera itself — and declaring the permission would make
      ACTION_IMAGE_CAPTURE demand a runtime grant it otherwise does not need.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!--
          Speech recognition is not part of Android: it is a service some installed app provides.
          Without this entry, package visibility on API 30+ hides every such service from this
          process and SpeechRecognizer.isRecognitionAvailable() answers false even on a device that
          has one.
        -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!--
          The same restriction applies to read-aloud: on API 30+ a text-to-speech engine is only
          visible to an app that asks for it. Google's engine is visible regardless, so this works
          without the entry on most phones — which is exactly why it is easy to miss. A phone whose
          default engine is another vendor's (Xiaomi, vivo and Huawei each ship their own) is the one
          that would otherwise report no engine.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AITutorApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AITutor">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AITutor"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a writable URI for one capture, without exporting app storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
